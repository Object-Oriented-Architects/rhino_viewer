<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.rhp</TargetExt>
    <NoWarn>NU1701</NoWarn>
    <RootNamespace>RhinoViewer</RootNamespace>
    <AssemblyName>RhinoViewer</AssemblyName>
    <ViewerAssetsDirectory>$(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)/viewer-assets</ViewerAssetsDirectory>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
      <_Parameter1>BCBAB3D3-CB00-43B3-AD3E-9D91AA5ABE19</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="8.*" ExcludeAssets="runtime" />
    <!-- Rhino 8.36 은 Eto 2.11 을 쓴다. 2.13 을 복사하면 어셈블리가 갈라져 패널이 빈 화면이 된다.
         런타임 자산을 제외해 Rhino 가 들고 있는 Eto.dll 을 그대로 쓰게 한다. -->
    <PackageReference Include="Eto.Forms" Version="2.11.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- 웹·셸·호스트를 ZIP으로 묶어 rhp 안에만 넣는다. -->
  <ItemGroup>
    <EmbeddedResource Include="$(ViewerAssetsDirectory).zip" LogicalName="RhinoViewer.Assets.zip" />
    <ViewerWebAsset Include="../dist/plugin-web/**/*" />
    <ViewerAssetInput Include="@(ViewerWebAsset);../dist/rhinoviewer-shell.html;../viewerhost/bin/Release/net48/RhinoViewerHost.exe;$(MSBuildProjectFullPath);../tools/build-shell.mjs;../tools/pack-plugin-web.mjs;../tools/pack-single-html.mjs;../tools/viewer-assets.mjs" />
  </ItemGroup>

  <Target Name="PrepareViewerAssets" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('../dist/plugin-web/viewer-live/index.html')"
           Text="플러그인 웹 자산이 없습니다. repo 루트에서 pnpm build:shell 을 먼저 실행하세요." />
    <Error Condition="!Exists('../dist/rhinoviewer-shell.html')"
           Text="내보내기 셸이 없습니다. repo 루트에서 pnpm build:shell 을 먼저 실행하세요." />
    <Error Condition="!Exists('../viewerhost/bin/Release/net48/RhinoViewerHost.exe')"
           Text="EXE 템플릿이 없습니다. dotnet build viewerhost\RhinoViewerHost.csproj -c Release 를 먼저 실행하세요." />
    <MakeDir Directories="$(ViewerAssetsDirectory)" />
    <!-- 파일 삭제도 감지하되, 같은 입력 목록은 mtime을 바꾸지 않는다. -->
    <WriteLinesToFile File="$(ViewerAssetsDirectory).inputs" Lines="@(ViewerAssetInput->'%(FullPath)')"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="PackViewerAssets" BeforeTargets="PrepareForBuild" DependsOnTargets="PrepareViewerAssets"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="@(ViewerAssetInput);$(ViewerAssetsDirectory).inputs" Outputs="$(ViewerAssetsDirectory).zip">
    <RemoveDir Directories="$(ViewerAssetsDirectory)" />
    <Copy SourceFiles="@(ViewerWebAsset)"
          DestinationFiles="@(ViewerWebAsset->'$(ViewerAssetsDirectory)/web/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="../dist/rhinoviewer-shell.html;../viewerhost/bin/Release/net48/RhinoViewerHost.exe"
          DestinationFolder="$(ViewerAssetsDirectory)" />
    <ZipDirectory SourceDirectory="$(ViewerAssetsDirectory)"
                  DestinationFile="$(ViewerAssetsDirectory).zip" Overwrite="true" />
  </Target>

</Project>
